    <string name="touch_learn">Learn how I type</string>
    <string name="touch_learn_desc">Reads each tap where you aimed, learns where your thumbs actually land on every key, and uses letter patterns only to settle taps that fall between keys. Learning stays on this device (and in your encrypted backups) and is skipped in password and incognito fields.</string>
